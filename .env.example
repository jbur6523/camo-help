BETA_MODE=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Resend email settings. Do not expose RESEND_API_KEY in frontend code.
RESEND_API_KEY=
EMAIL_FROM="CAMO Fighter Application Helper <no-reply@example.com>"
LICENSE_EMAIL_TO=
MEDICAL_EMAIL_TO=
ADMIN_EMAIL_TO=
SUPPORT_EMAIL_TO=support@camo-help.com

ADMIN_PASSWORD=
ADMIN_TOKEN=

# Server-side Supabase admin key. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side AI document pre-check. Disabled by default; never use NEXT_PUBLIC_ names.
DOCUMENT_CHECK_ENABLED=false
DOCUMENT_CHECK_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_DOCUMENT_CHECK_MODEL=gpt-5.6-luna
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DOCUMENT_CHECK_HASH_SECRET=
DOCUMENT_CHECK_BURST_LIMIT=3
DOCUMENT_CHECK_DAILY_LIMIT=10
DOCUMENT_CHECK_MONTHLY_LIMIT=500
DOCUMENT_CHECK_TIMEOUT_MS=20000
