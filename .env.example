BETA_MODE=true
# Keep live in production. Set disabled on staging/preview deployments to suppress every outbound email path.
CAMO_OUTBOUND_EMAIL_MODE=live

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Resend email settings. Do not expose RESEND_API_KEY in frontend code.
RESEND_API_KEY=
EMAIL_FROM="CAMO Fighter Application Helper <no-reply@example.com>"
LICENSE_EMAIL_TO=
MEDICAL_EMAIL_TO=
ADMIN_EMAIL_TO=
SUPPORT_EMAIL_TO=support@camo-help.com

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ADMIN_PASSWORD=
ADMIN_TOKEN=

# Server-side Supabase admin key. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
